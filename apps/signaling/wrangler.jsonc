{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "flicksend-signaling",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-14",
  "durable_objects": {
    "bindings": [
      { "name": "SESSION_DIRECTORY", "class_name": "SessionDirectory" },
      { "name": "SESSION_ROOM", "class_name": "SessionRoom" },
      { "name": "PRODUCTION_SESSION_ROOM", "class_name": "ProductionSessionRoom" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["SessionDirectory", "SessionRoom"] },
    { "tag": "v2", "new_sqlite_classes": ["ProductionSessionRoom"] }
  ]
}
