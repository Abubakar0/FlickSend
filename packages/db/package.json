{
  "name": "@flicksend/database",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "prisma/migrations"
  ],
  "scripts": {
    "build": "pnpm generate && tsc -p tsconfig.json",
    "generate": "node scripts/generate.mjs",
    "lint": "eslint src/client.ts src/index.ts --max-warnings 0",
    "migrate:deploy": "pnpm exec prisma migrate deploy --config prisma.config.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "pg": "8.23.0"
  },
  "devDependencies": {
    "@types/pg": "8.23.1",
    "prisma": "7.10.0"
  }
}
